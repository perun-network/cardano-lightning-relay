# Cardano Preprod configuration
# Copy to preprod.env and fill in actual values.

# Blockfrost API key (sign up at https://blockfrost.io/)
CARDANO_BLOCKFROST_URL=https://cardano-preprod.blockfrost.io/api/v0/
CARDANO_BLOCKFROST_KEY=preprodYOUR_KEY_HERE

# Operator credentials
CARDANO_SKEY_PATH=/secrets/operator.sk
CARDANO_OPERATOR_ADDRESS=addr_test1v...
CARDANO_OPERATOR_PKH=<operator_payment_key_hash_hex>

# Plutus script
CARDANO_SCRIPT_ADDRESS=addr_test1w...
CARDANO_SCRIPT_CBOR_PATH=/secrets/script_cbor.hex

# cBTC token
CARDANO_CBTC_POLICY_ID=<policy_id_hex>
CARDANO_CBTC_ASSET_NAME=63425443
